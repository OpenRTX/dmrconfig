CC              = gcc

VERSION         = $(shell git describe --tags --abbrev=0)
GITCOUNT        = $(shell git rev-list HEAD --count)
CFLAGS          = -g -O -Wall -Werror -DVERSION='"$(VERSION).$(GITCOUNT)"'
LDFLAGS         = -g -s

# Use a separate build directory to avoid colliding with Linux .o files
BDIR            = win32
OBJS            = $(BDIR)/main.o $(BDIR)/util.o $(BDIR)/radio.o $(BDIR)/dfu-windows.o \
                  $(BDIR)/uv380.o $(BDIR)/md380.o $(BDIR)/rd5r.o $(BDIR)/gd77.o \
                  $(BDIR)/hid.o $(BDIR)/hid-windows.o $(BDIR)/serial.o \
                  $(BDIR)/anytone_ht.o $(BDIR)/dm1801.o $(BDIR)/dm32.o
LIBS            = -lhid -lsetupapi -lmsvcrt

# Compiling Windows binary from Linux (prefer 64-bit, fall back to 32-bit)
ifeq (/usr/bin/x86_64-w64-mingw32-gcc,$(wildcard /usr/bin/x86_64-w64-mingw32-gcc))
    CC          = x86_64-w64-mingw32-gcc
endif
ifeq (/usr/bin/i586-mingw32msvc-gcc,$(wildcard /usr/bin/i586-mingw32msvc-gcc))
    CC          = i586-mingw32msvc-gcc
endif
ifeq (/usr/bin/i686-w64-mingw32-gcc,$(wildcard /usr/bin/i686-w64-mingw32-gcc))
    CC          = i686-w64-mingw32-gcc
endif

# Compiling Windows binary from Mac OS
ifeq (/usr/local/bin/i686-w64-mingw32-gcc,$(wildcard /usr/local/bin/i686-w64-mingw32-gcc))
    CC          = i686-w64-mingw32-gcc
endif

all:            dmrconfig.exe

$(BDIR):
		mkdir -p $(BDIR)

dmrconfig.exe:  $(OBJS)
		$(CC) $(LDFLAGS) -o $@ $(OBJS) $(LIBS)

clean:
		rm -rf $(BDIR) dmrconfig.exe

###
$(BDIR)/anytone_ht.o: anytone_ht.c radio.h util.h anytone_ht-map.h | $(BDIR)
		$(CC) $(CFLAGS) -c -o $@ anytone_ht.c
$(BDIR)/dfu-windows.o: dfu-windows.c util.h | $(BDIR)
		$(CC) $(CFLAGS) -c -o $@ dfu-windows.c
$(BDIR)/dm32.o: dm32.c radio.h util.h | $(BDIR)
		$(CC) $(CFLAGS) -c -o $@ dm32.c
$(BDIR)/gd77.o: gd77.c radio.h util.h | $(BDIR)
		$(CC) $(CFLAGS) -c -o $@ gd77.c
$(BDIR)/hid.o: hid.c util.h | $(BDIR)
		$(CC) $(CFLAGS) -c -o $@ hid.c
$(BDIR)/hid-windows.o: hid-windows.c util.h | $(BDIR)
		$(CC) $(CFLAGS) -c -o $@ hid-windows.c
$(BDIR)/main.o: main.c radio.h util.h | $(BDIR)
		$(CC) $(CFLAGS) -c -o $@ main.c
$(BDIR)/md380.o: md380.c radio.h util.h | $(BDIR)
		$(CC) $(CFLAGS) -c -o $@ md380.c
$(BDIR)/radio.o: radio.c radio.h util.h | $(BDIR)
		$(CC) $(CFLAGS) -c -o $@ radio.c
$(BDIR)/rd5r.o: rd5r.c radio.h util.h | $(BDIR)
		$(CC) $(CFLAGS) -c -o $@ rd5r.c
$(BDIR)/serial.o: serial.c util.h | $(BDIR)
		$(CC) $(CFLAGS) -c -o $@ serial.c
$(BDIR)/util.o: util.c util.h | $(BDIR)
		$(CC) $(CFLAGS) -c -o $@ util.c
$(BDIR)/uv380.o: uv380.c radio.h util.h | $(BDIR)
		$(CC) $(CFLAGS) -c -o $@ uv380.c
$(BDIR)/dm1801.o: dm1801.c radio.h util.h | $(BDIR)
		$(CC) $(CFLAGS) -c -o $@ dm1801.c
